# Copy this file to config.env and set the values. config.env is git-ignored.
INSTANCE_IP=<INSTANCE_IP>
SSH_USER=opc
SSH_KEY_PATH=<PATH_TO_PRIVATE_KEY>
# Optional. Set to the private IP of the Peer to enable network Tests.
PEER_PRIVATE_IP=
# OCI settings for the Peer scripts (harness/peer/*.sh)
OCI_PROFILE=<OCI_CLI_PROFILE>
COMPARTMENT_ID=<COMPARTMENT_OCID>
SUBNET_ID=<SUBNET_OCID>
AVAILABILITY_DOMAIN=<AVAILABILITY_DOMAIN>
IMAGE_ID=<ORACLE_LINUX_9_AARCH64_IMAGE_OCID>
SSH_PUBLIC_KEY_PATH=<PATH_TO_PUBLIC_KEY>
PEER_SOURCE_CIDR=10.0.0.0/24
